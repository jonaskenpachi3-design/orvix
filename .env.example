PORT=3000
DATABASE_URL=postgresql://usuario:senha@localhost:5432/orvix
JWT_SECRET=sua-chave-secreta-aqui
NODE_ENV=development
# Opcional: defina se o frontend estiver em outra origem.
CORS_ORIGIN=
# Opcional: sem a chave, o chat com IA fica indisponível.
# IA do chat (use UM provedor). Gratuito: crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo (padrão llama-3.3-70b-versatile) e provedor (groq | anthropic | openai-compatible)
# AI_MODEL=llama-3.3-70b-versatile
# AI_PROVIDER=groq
# Alternativa paga (Claude):
# ANTHROPIC_API_KEY=
# Qualquer API no formato OpenAI (OpenRouter, Cerebras...): AI_PROVIDER=openai-compatible + AI_API_KEY + AI_BASE_URL + AI_MODEL